-- name: test_decimal_overflow_reduce_scale_partition_selection @native
SET sql_mode = '';
-- result:
-- !result
SET decimal_overflow_reduce_scale = false;
-- result:
-- !result
CREATE TABLE partitioned (
    k INT,
    g BIGINT AS COALESCE(CAST(CAST(k AS DECIMAL(38,18)) / CAST(50.25 AS DECIMAL(38,18)) AS BIGINT), -1)
) DUPLICATE KEY(k) PARTITION BY (k, g)
DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ('replication_num'='1');
-- result:
-- !result
INSERT INTO partitioned (k) VALUES (0), (1000);
-- result:
-- !result
SET decimal_overflow_reduce_scale = true;
-- result:
-- !result
SELECT k, g, COALESCE(CAST(CAST(k AS DECIMAL(38,18)) / CAST(50.25 AS DECIMAL(38,18)) AS BIGINT), -1) AS computed
FROM partitioned ORDER BY k;
-- result:
0	0	0
1000	-1	19
-- !result
-- CRC32 forces the partitions_meta fallback to evaluate the session arithmetic.
ALTER TABLE partitioned DROP PARTITIONS WHERE
    crc32(CAST(COALESCE(CAST(CAST(k AS DECIMAL(38,18)) / CAST(50.25 AS DECIMAL(38,18)) AS BIGINT), -1) AS VARCHAR))
    IN (crc32('-1'), crc32('0'));
-- result:
-- !result
SELECT k FROM partitioned ORDER BY k;
-- result:
1000
-- !result
SET decimal_overflow_reduce_scale = false;
-- result:
-- !result
ALTER TABLE partitioned DROP PARTITIONS WHERE
    crc32(CAST(COALESCE(CAST(CAST(k AS DECIMAL(38,18)) / CAST(50.25 AS DECIMAL(38,18)) AS BIGINT), -1) AS VARCHAR)) = crc32('-1');
-- result:
-- !result
SELECT count(*) FROM partitioned;
-- result:
0
-- !result
-- The fallback must resolve nested SQL functions in the database of the calling session.
CREATE FUNCTION base_rate(x DECIMAL(38,18)) RETURNS x / CAST(50.25 AS DECIMAL(38,18));
-- result:
-- !result
CREATE FUNCTION outer_rate(x DECIMAL(38,18)) RETURNS base_rate(x);
-- result:
-- !result
CREATE TABLE udf_partitioned (
    k INT,
    g BIGINT AS COALESCE(CAST(outer_rate(CAST(k AS DECIMAL(38,18))) AS BIGINT), -1)
) DUPLICATE KEY(k) PARTITION BY (k, g)
DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ('replication_num'='1');
-- result:
-- !result
INSERT INTO udf_partitioned (k) VALUES (0), (1000);
-- result:
-- !result
SET decimal_overflow_reduce_scale = true;
-- result:
-- !result
SELECT k, g, COALESCE(CAST(outer_rate(CAST(k AS DECIMAL(38,18))) AS BIGINT), -1) AS computed
FROM udf_partitioned ORDER BY k;
-- result:
0	0	0
1000	-1	19
-- !result
ALTER TABLE udf_partitioned DROP PARTITIONS WHERE
    crc32(CAST(COALESCE(CAST(outer_rate(CAST(k AS DECIMAL(38,18))) AS BIGINT), -1) AS VARCHAR))
    IN (crc32('-1'), crc32('0'));
-- result:
-- !result
SELECT k FROM udf_partitioned ORDER BY k;
-- result:
1000
-- !result
-- The same predicate uses the stored key on the FE in stock mode. With scale reduction it must
-- calculate the division from k in partitions_meta and also read g by its physical name.
CREATE TABLE named_key (
    k INT, g BIGINT AS CRC32(CAST(COALESCE(CAST(CAST(k AS DECIMAL(38,18)) / CAST(50.25 AS DECIMAL(38,18)) AS BIGINT), -1) AS VARCHAR))
) DUPLICATE KEY(k) PARTITION BY (k, g)
DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ('replication_num'='1');
-- result:
-- !result
INSERT INTO named_key (k) VALUES (0), (100), (1000);
-- result:
-- !result
ALTER TABLE named_key DROP PARTITIONS WHERE
    CRC32(CAST(COALESCE(CAST(CAST(k AS DECIMAL(38,18)) / CAST(50.25 AS DECIMAL(38,18)) AS BIGINT), -1) AS VARCHAR)) > 3000000000
    AND g >= 0;
-- result:
-- !result
SELECT k FROM named_key ORDER BY k;
-- result:
100
