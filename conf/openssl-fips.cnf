# OpenSSL configuration for running StarRocks BE/CN in FIPS mode.
# Loaded by the BE when enable_fips_mode = true in be.conf / cn.conf.
# Installed as lib/openssl-fips/openssl-fips.cnf; not meant to be edited per host.
#
# fipsmodule.cnf is generated on each host by `openssl fipsinstall` at startup
# and must never be copied between hosts or edited by hand.

config_diagnostics = 1
openssl_conf = openssl_init

.include $ENV::STARROCKS_HOME/conf/fipsmodule.cnf

[openssl_init]
providers = provider_sect
alg_section = algorithm_sect

[provider_sect]
fips = fips_sect
base = base_sect
# needed only for non-security checksums fetched explicitly with "fips=no"
default = default_sect

[base_sect]
activate = 1

[default_sect]
activate = 1

[algorithm_sect]
default_properties = fips=yes
